<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>QLIsDataBasedPreview</key>
			<false/>
			<key>QLSupportedContentTypes</key>
			<array>
				<string>com.unity3d.meta</string>
				<string>com.unity3d.package</string>
			</array>
			<key>QLSupportsSearchableItems</key>
			<false/>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.preview</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).PreviewViewController</string>
	</dict>
    <key>UTImportedTypeDeclarations</key>
    <array>
      <!-- .meta 文件 -->
      <dict>
        <key>UTTypeIdentifier</key>
        <string>com.unity3d.meta</string>
        <key>UTTypeDescription</key>
        <string>Unity Meta File</string>
        <key>UTTypeConformsTo</key>
        <array>
          <string>public.data</string>
        </array>
        <key>UTTypeTagSpecification</key>
        <dict>
          <key>public.filename-extension</key>
          <array><string>meta</string></array>
        </dict>
      </dict>
      <!-- .unitypackage 文件（注意扩展名 tag 是 unitypackage，不是 package） -->
      <dict>
        <key>UTTypeIdentifier</key>
        <string>com.unity3d.package</string>
        <key>UTTypeDescription</key>
        <string>Unity Package</string>
        <key>UTTypeConformsTo</key>
        <array>
          <string>public.data</string>
        </array>
        <key>UTTypeTagSpecification</key>
        <dict>
          <key>public.filename-extension</key>
          <array><string>unitypackage</string></array>
        </dict>
      </dict>
    </array>
</dict>
</plist>
